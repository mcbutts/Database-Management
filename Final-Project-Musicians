void insert()
{
    string artistID, stage_name, real_name, age, genre, hometown;
    int rclabel_id, homeven_id;


    cout << "Artist ID: ";
    cin >> artistID;
    cout << "Stage Name: ";
    cin >> stage_name;
    cout << "Real Name: ";
    cin >> real_name;
    cout << "Age: ";
    cin >> age;
    cout << "Genre: ";
    cin >> genre;
    cout << "Hometown: ";
    cin >> hometown;
    cout << "Record Label ID: ";
    cin >> rclabel_id;


    // Check if the provided rclabel_id exists in the Record_Label table
    prep_stmt = con->prepareStatement("SELECT COUNT(*) FROM Record_Label WHERE rclabel_id = ?");
    prep_stmt->setInt(1, rclabel_id);
    res = prep_stmt->executeQuery();
    res->next();
    int labelCount = res->getInt(1);


    if (labelCount == 0)
    {
        cout << "Record Label ID does not exist in the Record_Label table. Do you want to add it? (y/n): ";
        char choice;
        cin >> choice;


        if (choice == 'y' || choice == 'Y')
        {
            // Insert the new record label
            // Assume the user provides the necessary information for the new record label
            // For simplicity, let's assume the user provides all required fields
            string rclabel_name, founder_name, located;
            int founded_year;
            cout << "Record Label Name: ";
            cin.ignore(); // Clear the input buffer
            getline(cin, rclabel_name);
            cout << "Founder Name: ";
            getline(cin, founder_name);
            cout << "Founded Year: ";
            cin >> founded_year;
            cout << "Located: ";
            cin.ignore(); // Clear the input buffer
            getline(cin, located);


            prep_stmt = con->prepareStatement("INSERT INTO Record_Label (rclabel_id, rclabel, founder, founded, located) VALUES (?, ?, ?, ?, ?)");
            prep_stmt->setInt(1, rclabel_id);
            prep_stmt->setString(2, rclabel_name);
            prep_stmt->setString(3, founder_name);
            prep_stmt->setInt(4, founded_year);
            prep_stmt->setString(5, located);


            prep_stmt->execute();
        }
        else
        {
            cout << "Insertion canceled." << endl;
            return;
        }
    }


    cout << "Venue ID: ";
    cin >> homeven_id;


    // Check if the provided homeven_id exists in the Venues table
    prep_stmt = con->prepareStatement("SELECT COUNT(*) FROM Venues WHERE homeven_id = ?");
    prep_stmt->setInt(1, homeven_id);
    res = prep_stmt->executeQuery();
    res->next();
    int venueCount = res->getInt(1);


    if (venueCount == 0)
    {
        cout << "Venue ID does not exist in the Venues table. Do you want to add it? (y/n): ";
        char choice;
        cin >> choice;


        if (choice == 'y' || choice == 'Y')
        {
            // Insert the new venue
            // Assume the user provides the necessary information for the new venue
            // For simplicity, let's assume the user provides all required fields
            string ven_name, ven_location;
            int capacity;
            cout << "Venue Name: ";
            cin.ignore(); // Clear the input buffer
            getline(cin, ven_name);
            cout << "Venue Location: ";
            getline(cin, ven_location);
            cout << "Capacity: ";
            cin >> capacity;


            prep_stmt = con->prepareStatement("INSERT INTO Venues (homeven_id, ven_name, venLo, capacity, artistID) VALUES (?, ?, ?, ?, ?)");
            prep_stmt->setInt(1, homeven_id);
            prep_stmt->setString(2, ven_name);
            prep_stmt->setString(3, ven_location);
            prep_stmt->setInt(4, capacity);
            prep_stmt->setInt(5, 0); // Set artistID to 0 as we're not associating with any artist initially


            prep_stmt->execute();
        }
        else
        {
            cout << "Insertion canceled." << endl;
            return;
        }
    }


    prep_stmt = con->prepareStatement("INSERT INTO Artists (artistID, stage_name, real_name, age, genre, hometown, rclabel_id, homeven_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
    prep_stmt->setString(1, artistID);
    prep_stmt->setString(2, stage_name);
    prep_stmt->setString(3, real_name);
    prep_stmt->setString(4, age);
    prep_stmt->setString(5, genre);
    prep_stmt->setString(6, hometown);
    prep_stmt->setInt(7, rclabel_id);
    prep_stmt->setInt(8, homeven_id);


    prep_stmt->execute();
}






