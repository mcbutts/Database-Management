void deleteArtist()
{
    int id;


    cout << "Enter the ID of the artist you want to delete: ";
    cin >> id;


    prep_stmt = con->prepareStatement("DELETE FROM Artists WHERE artistID = ?");
    prep_stmt->setInt(1, id);
    prep_stmt->execute();
    cout << "Artist deleted successfully." << endl;
}


void updateArtist()
{
    int id;
    string column, newValue;


    cout << "Enter the ID of the artist you want to update: ";
    cin >> id;
    cout << "Enter the column you want to update (stage_name, real_name, age, genre, hometown, rclabel_id, homeven_id): ";
    cin >> column;
    cout << "Enter the new value: ";
    cin >> newValue;


    prep_stmt = con->prepareStatement("UPDATE Artists SET " + column + " = ? WHERE artistID = ?");
    prep_stmt->setString(1, newValue);
    prep_stmt->setInt(2, id);
    prep_stmt->execute();
    cout << "Artist information updated successfully." << endl;
}


void createViewAverageAge()
{
    try
    {
        stmt = con->createStatement();
        stmt->execute("CREATE OR REPLACE VIEW View_AverageAge AS SELECT genre, AVG(age) as AverageAge FROM Artists GROUP BY genre");


        // Output the information to the terminal
        res = stmt->executeQuery("SELECT * FROM View_AverageAge");
        cout << "View for Average Age by Genre created successfully." << endl;
        cout << "Genre\t\t| Average Age" << endl;
        while (res->next())
        {
            cout << res->getString("genre") << "\t| ";
            cout << res->getString("AverageAge") << endl;
        }
    }
    catch (sql::SQLException &e)
    {
        cout << "# ERR: SQLException in " << __FILE__;
        cout << "(" << __FUNCTION__ << ") on line " << __LINE__ << endl;
        cout << "# ERR: " << e.what();
        cout << " (MySQL error code: " << e.getErrorCode();
        cout << ", SQLState: " << e.getSQLState() << " )" << endl;
    }
}


void countArtistsYoungerThan50()
{
    try
    {
        stmt = con->createStatement();
        res = stmt->executeQuery("SELECT COUNT(*) AS younger_than_50 FROM Artists WHERE age < 50");


        if (res->next())
        {
            cout << "Number of Artists Younger Than Age 50: " << res->getInt("younger_than_50") << endl;
        }
    }
    catch (sql::SQLException &e)
    {
        cout << "# ERR: SQLException in " << __FILE__;
        cout << "(" << __FUNCTION__ << ") on line " << __LINE__ << endl;
        cout << "# ERR: " << e.what();
        cout << " (MySQL error code: " << e.getErrorCode();
        cout << ", SQLState: " << e.getSQLState() << " )" << endl;
    }
}
